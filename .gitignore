# Local placeholder values for functions' defineSecret()s (Functions emulator reads this
# instead of prompting/hitting real Secret Manager) — never real credentials, never committed.
functions/.secret.local

# Machine-local port override for the Functions emulator (this machine has another project's
# dev server parked on 5001) — see firebase.json for the real, committed emulator ports.
firebase.local-test.json

# Real client data dropped in uploads/ for reference (e.g. real building/tenant
# exports, generated client reports) — never goes into git, even in a private repo.
# Broadened after a pre-production audit found a real generated client report (a PDF with real
# names/scores) sitting untracked with nothing stopping a routine `git add -A`/`git add .` from
# committing it — once committed, a file is compromised forever even after a later deletion.
# .docx is deliberately NOT included here — the 2 tracked files in uploads/ today are content-
# review copies (induction wording, not client data) and are expected to stay tracked.
uploads/*.xlsx
uploads/*.pdf
uploads/*.csv

# Bintracker Data Sharing API test-environment credentials (Point 1 / Workstream 7) — reused
# from Bin Tally's own existing test account, never real production credentials, never committed.
tools/.bintracker-test-credentials.local

# Temporary, one-off copy of the real SMTP credentials (matching what's in Secret Manager) used
# only to test the login directly against smtp.office365.com outside a full deploy — delete this
# file once the test is done, never committed.
functions/.smtp-test-credentials.local
