rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Accounts allowed to read, export, or delete submission data (the report tool).
    // The owner email is a permanent fallback (can never be locked out); anyone else
    // is granted access by having a doc in /admins, managed from the report's Admins
    // panel — no rules edit/redeploy needed to add or remove a reviewer.
    function isAllowedReviewer() {
      return request.auth != null &&
        (request.auth.token.email == 'esgtradeflex@gmail.com' ||
         exists(/databases/$(database)/documents/admins/$(request.auth.token.email)));
    }

    // Narrow-scope counterpart to isAllowedReviewer(): does this signed-in user have an
    // explicit grant for THIS ONE building (via a buildingAccess doc), rather than access
    // to everything. Deliberately a SEPARATE collection from /admins — isAllowedReviewer()
    // is a bare exists() check with no field inspection, so a scoped grant living inside
    // /admins would itself satisfy isAllowedReviewer() and hand out full global access.
    // Not yet referenced by any collection's rules below (added inert first, wired in once
    // its own tests are green — see the roadmap plan for the staged rollout).
    function isBuildingScopedReviewer(buildingId) {
      return request.auth != null && buildingId is string && buildingId.size() > 0 &&
        exists(/databases/$(database)/documents/buildingAccess/$(request.auth.token.email + '__' + buildingId));
    }

    // Additive only: always at least as permissive as isAllowedReviewer() alone, since that's
    // the first operand of the ||. A global admin is never narrowed by this.
    function canReviewBuilding(buildingId) {
      return isAllowedReviewer() || isBuildingScopedReviewer(buildingId);
    }

    // Bounds + a loose shape check on the person-identifying + program fields shared by
    // submissions and attempts — both are created by anonymous, unauthenticated
    // trainees, so this is the only server-side defense against garbage/oversized/
    // spoofed data (the client UI only ever sends well-formed values, but nothing
    // stops a direct API call from sending anything else).
    // programId tags which training course a doc belongs to (only "recycling-sorting"
    // exists today) — required now, before any real data exists, so a future second
    // training course never has to backfill/guess it on old docs.
    function isValidPersonFields(data) {
      return data.buildingId is string && data.buildingId.size() > 0 && data.buildingId.size() <= 200
        && data.tenantId is string && data.tenantId.size() > 0 && data.tenantId.size() <= 200
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.email is string && data.email.size() > 0 && data.email.size() <= 320
        && data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && data.programId is string && data.programId.size() > 0 && data.programId.size() <= 100;
    }

    // A submission/attempt MAY carry a linkId (came in via ?l=, a tenant-scoped and/or
    // time-limited link — see /links below). When it does, this is the real server-side
    // enforcement of expiry: a client-side "this link has expired" message is only a courtesy,
    // since nothing stops a direct API call from ignoring it. Absent linkId (the plain ?b=
    // link, or no link param at all) always passes — this check only ever narrows, never
    // requires, a linkId.
    function isValidLinkIfPresent(data) {
      return !('linkId' in data) ||
        (data.linkId is string &&
         (!('expiresAt' in get(/databases/$(database)/documents/links/$(data.linkId)).data) ||
          get(/databases/$(database)/documents/links/$(data.linkId)).data.expiresAt > request.time));
    }

    // Reviewer accounts beyond the permanent owner fallback above. Only an existing
    // reviewer can grant or revoke another one (the report's Admins panel is only
    // reachable once signed in as an allowed reviewer in the first place).
    match /admins/{email} {
      allow read, write: if isAllowedReviewer();
    }

    // Per-building grants for external/scoped clients (e.g. a building's own property
    // manager) — see isBuildingScopedReviewer() above. One doc per (email, building) pair,
    // keyed `${email}__${buildingId}`, not one doc per client with an array, so granting/
    // revoking one building is a single independent write with no read-modify-write race.
    // Only an internal reviewer can grant/revoke; a scoped client may read only their own
    // grant docs (to discover which buildings they can see), never anyone else's or write
    // any of them.
    match /buildingAccess/{grantId} {
      allow read: if isAllowedReviewer() ||
        (request.auth != null && resource.data.email == request.auth.token.email);
      allow write: if isAllowedReviewer();
    }

    // Building + tenant catalog: readable by anyone with a link (needed to
    // populate the id-gate dropdowns), writable only by the admin panel's
    // signed-in reviewer (creating buildings/tenants, generating links).
    match /buildings/{buildingId} {
      allow read: if true;
      allow write: if isAllowedReviewer();

      match /tenants/{tenantId} {
        allow read: if true;
        allow write: if isAllowedReviewer();
      }
    }

    // Program catalog (Recycling Sorting, and future specialized inductions like
    // Organics Focus / Battery Disposal). Readable by anyone — needed by the
    // unauthenticated induction-catalog screen and, indirectly, by every induction
    // page — writable only by an allowed reviewer from the report's Catalog panel.
    match /programs/{programId} {
      allow read: if true;
      allow write: if isAllowedReviewer();
    }

    // Which buildings are enrolled in which program, plus that program's
    // per-building config (item overrides, enabled tenants). Replaces the old
    // buildings/{id}.itemOverrides field now that a building can be enrolled in
    // more than one program. Same read-by-anyone/write-by-reviewer shape as
    // buildings itself, since every induction page's id-gate reads this before
    // showing the form (and treats a missing doc as "not enrolled, invalid link").
    match /enrollments/{enrollmentId} {
      allow read: if true;
      allow write: if isAllowedReviewer();
    }

    // Distribution links: tenant-scoped and/or time-limited alternatives to the
    // plain ?b= building link. Readable by anyone — a trainee needs to resolve one
    // before the id-gate even knows the building — the same capability-URL model
    // as the link ids themselves: security comes from the id being an unguessable
    // random token, not from this rule. Reviewers can create and update (update is
    // how an early revoke works — set expiresAt to now) but never delete, so a
    // resolved link's record never disappears out from under a check.
    match /links/{linkId} {
      allow read: if true;
      allow create, update: if isAllowedReviewer();
      allow delete: if false;
    }

    // Training results: anyone can create one (completing the game), nobody
    // can create with a payload missing the required fields, nobody can ever
    // edit a submission after the fact, and only an allowed reviewer can
    // read or delete them.
    match /submissions/{submissionId} {
      allow create: if isValidPersonFields(request.resource.data)
        && isValidLinkIfPresent(request.resource.data)
        && request.resource.data.score is number
        && request.resource.data.score >= 0 && request.resource.data.score <= 100;
      // read: a global reviewer sees any submission; a scoped client (via /buildingAccess)
      // sees only submissions for their own granted building(s). delete stays reviewer-only —
      // a scoped client is view-only, never allowed to remove a training record.
      allow read: if canReviewBuilding(resource.data.buildingId);
      allow delete: if isAllowedReviewer();
      allow update: if false;
    }

    // "Started the sort" pings, written the moment someone clicks Begin the sort —
    // lets the report compute a completion rate (started vs. actually finished).
    // Same shape/rules as submissions, minus the score field this doesn't have.
    match /attempts/{attemptId} {
      allow create: if isValidPersonFields(request.resource.data) && isValidLinkIfPresent(request.resource.data);
      // Same scoping as submissions.read above — global reviewer sees all, scoped client
      // sees only their granted building(s).
      allow read: if canReviewBuilding(resource.data.buildingId);
      allow update, delete: if false;
    }
  }
}
