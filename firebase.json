{
  "hosting": {
    "public": "outputs",
    "ignore": [
      "firebase.json",
      "**/.*",
      "icon-audit.html",
      "*.docx"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "auth": {
      "port": 9099
    },
    "ui": {
      "enabled": false
    }
  }
}
